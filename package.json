{
  "name": "holotransfer",
  "private": true,
  "version": "0.2.3",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "api:dev": "pnpm --filter @holotransfer/api dev",
    "api:start": "pnpm --filter @holotransfer/api start",
    "web:dev": "pnpm --filter @holotransfer/web dev",
    "web:start": "pnpm --filter @holotransfer/web start",
    "dev": "concurrently \"pnpm api:dev\" \"pnpm web:dev\"",
    "start": "concurrently \"pnpm api:start\" \"pnpm web:start\"",
    "windows:dev": "pnpm version:sync && pnpm --filter @holotransfer/desktop tauri dev",
    "windows:build": "pnpm version:sync && pnpm --filter @holotransfer/desktop tauri build",
    "linux:dev": "pnpm version:sync && pnpm --filter @holotransfer/desktop tauri dev",
    "linux:build": "pnpm version:sync && pnpm --filter @holotransfer/desktop tauri build",
    "mac:dev": "pnpm version:sync && pnpm --filter @holotransfer/desktop tauri dev",
    "mac:build": "pnpm version:sync && pnpm --filter @holotransfer/desktop tauri build",
    "android:dev": "pnpm version:sync && pnpm --filter @holotransfer/desktop tauri android dev",
    "android:build": "pnpm version:sync && pnpm --filter @holotransfer/desktop tauri android build",
    "ios:dev": "pnpm version:sync && pnpm --filter @holotransfer/desktop tauri ios dev",
    "ios:build": "pnpm version:sync && pnpm --filter @holotransfer/desktop tauri ios build",
    "build": "pnpm --recursive build",
    "version:sync": "node scripts/sync-tauri-version.mjs",
    "stop": "docker compose down",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "serve": "^14.2.4"
  }
}
