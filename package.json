{
  "name": "holotransfer",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @holotransfer/api dev\" \"pnpm --filter @holotransfer/web dev\"",
    "build": "pnpm --recursive build",
    "start": "docker compose up --build -d",
    "stop": "docker compose down",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "serve": "^14.2.4"
  }
}
