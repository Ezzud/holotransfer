{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HoloTransfer",
  "version": "0.1.7",
  "identifier": "app.holotransfer.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev -- --mode tauri",
    "beforeBuildCommand": "pnpm --dir ../web exec tsc -b && pnpm --dir ../web exec vite build --mode tauri",
    "devUrl": "http://localhost:51739",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "HoloTransfer",
        "backgroundColor": "#17141a",
        "width": 1080,
        "height": 760,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost https://api.holotransfer.app https://transfer-api.ezzud.fr https://api.github.com; connect-src 'self' ipc: http://ipc.localhost https://api.holotransfer.app https://transfer-api.ezzud.fr https://api.github.com wss://api.holotransfer.app wss://transfer-api.ezzud.fr; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5Q0Q3QjM4NUM4RTY3MDIKUldRQ1o0NWNPSHZOS2E0L3E2SjUydThNYkQ4U2J2SmRNYUlGR3FUNVlCaW1FRk0xRlNPbHVJaGMK",
      "endpoints": [
        "https://github.com/Ezzud/holotransfer/releases/latest/download/latest.json"
      ]
    }
  }
}
